# GEMINI_API_KEY: Required for Gemini AI bill scanner and financial feedback.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Supabase Server-Side Configuration (Protected on backend, never exposed to browser)
# Supabase Server-Side Configuration (Protected on backend, never exposed to browser)
SUPABASE_URL="MY_SUPABASE_URL"
SUPABASE_ANON_KEY="MY_SUPABASE_ANON_KEY"
SUPABASE_SERVICE_ROLE_KEY="MY_SUPABASE_SERVICE_ROLE_KEY"

# Firebase Web App Config (used client-side for Google sign-in / Calendar sync)
# These are exposed to the browser bundle by design (Vite requires the VITE_ prefix) —
# Firebase's security model relies on Security Rules and OAuth consent, not key secrecy.
VITE_FIREBASE_PROJECT_ID="MY_FIREBASE_PROJECT_ID"
VITE_FIREBASE_APP_ID="MY_FIREBASE_APP_ID"
VITE_FIREBASE_API_KEY="MY_FIREBASE_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="MY_FIREBASE_AUTH_DOMAIN"
VITE_FIREBASE_STORAGE_BUCKET="MY_FIREBASE_STORAGE_BUCKET"
VITE_FIREBASE_MESSAGING_SENDER_ID="MY_FIREBASE_MESSAGING_SENDER_ID"
VITE_FIREBASE_OAUTH_CLIENT_ID="MY_FIREBASE_OAUTH_CLIENT_ID"
